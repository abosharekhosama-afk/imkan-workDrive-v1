generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// All DateTime columns are stored in UTC.
enum OrgRole {
  ADMIN
  MEMBER
}

enum TeamFolderRole {
  ADMIN
  ORGANIZER
  EDITOR
  VIEWER
}

enum ResourceType {
  FILE
  FOLDER
}

/// Lifecycle state of a logical file.
enum FileStatus {
  ACTIVE
  TRASHED
  ARCHIVED
  PURGED
}

/// Coarse content classification derived from mimeType (never a replacement for it).
enum FileType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  PDF
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  TEXT
  CODE
  OTHER
}

enum FileVisibility {
  PRIVATE
  ORGANIZATION
  TEAM
  SHARED
  PUBLIC_LINK
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
  ORGANIZE
  FULL_ACCESS
}

enum ShareStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  SHARE
  COMMENT
  MENTION
  INVITATION
  FILE_UPLOADED
  FILE_UPDATED
  FILE_DELETED
  FILE_RESTORED
  VERSION_CREATED
  VERSION_RESTORED
  ACCESS_REQUEST
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Security/system audit actions. Kept separate from the user-facing file timeline.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  MOVE
  COPY
  DOWNLOAD
  PREVIEW
  SHARE
  UNSHARE
  COMMENT
  UPLOAD_VERSION
  RESTORE_VERSION
  LOGIN
  LOGOUT
  INVITE
  ACCEPT_INVITATION
  REVOKE_INVITATION
  CHANGE_PERMISSION
}

enum TrashReason {
  USER_DELETED
  OWNER_DELETED
  PARENT_DELETED
  ADMIN_DELETED
}

enum VersionStatus {
  ACTIVE
  RESTORED
  SUPERSEDED
  DELETED
}

enum AccessAction {
  VIEW
  PREVIEW
  DOWNLOAD
  EDIT
  COMMENT
  SHARE
  MOVE
  COPY
  DELETE
  RESTORE
}

enum StorageObjectStatus {
  ACTIVE
  DELETED
  CORRUPTED
}

model Organization {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users             User[]
  teamFolders       TeamFolder[]
  teamFolderMembers TeamFolderMember[]
  folders           Folder[]
  files             File[]
  fileVersions      FileVersion[]
  storageObjects    StorageObject[]
  shares            FileShare[]
  shareRecipients   FileShareRecipient[]
  auditLogs         AuditLog[]
  favorites         Favorite[]
  accessEvents      AccessEvent[]
  sessions          Session[]
  notifications     Notification[]
  comments          Comment[]
  quota             StorageQuota?
  invitations       OrganizationInvitation[]
  tags              Tag[]
  trashEntries      TrashEntry[]
  fileActivities    FileActivity[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  orgId        String   @map("org_id") @db.Char(36)
  email        String
  name         String?
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  role         OrgRole
  createdAt    DateTime @default(now()) @map("created_at")

  organization      Organization             @relation(fields: [orgId], references: [id])
  teamFolderMembers TeamFolderMember[]
  ownedFolders      Folder[]                 @relation("FolderOwner")
  ownedFiles        File[]                   @relation("FileOwner")
  uploadedVersions  FileVersion[]            @relation("VersionUploader")
  auditLogs         AuditLog[]
  favorites         Favorite[]
  accessEvents      AccessEvent[]
  shareRecipients   FileShareRecipient[]
  sharesCreated     FileShare[]              @relation("FileShareCreator")
  sessions          Session[]
  notifications     Notification[]
  comments          Comment[]
  resetTokens       PasswordResetToken[]
  invitationsSent   OrganizationInvitation[] @relation("InvitationSender")
  trashDeletedBy    TrashEntry[]             @relation("TrashEntryDeletedBy")
  trashRestoredBy   TrashEntry[]             @relation("TrashEntryRestoredBy")
  fileActivities    FileActivity[]

  @@unique([orgId, email])
  @@index([orgId])
  @@map("users")
}

model TeamFolder {
  id            String  @id @default(uuid()) @db.Char(36)
  orgId         String  @map("org_id") @db.Char(36)
  name          String
  isPublicToOrg Boolean @default(false) @map("is_public_to_org")

  organization Organization       @relation(fields: [orgId], references: [id])
  members      TeamFolderMember[]
  folders      Folder[]

  @@index([orgId])
  @@map("team_folders")
}

model TeamFolderMember {
  teamFolderId String         @map("team_folder_id") @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  orgId        String         @map("org_id") @db.Char(36)
  role         TeamFolderRole

  teamFolder   TeamFolder   @relation(fields: [teamFolderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([teamFolderId, userId])
  @@index([orgId])
  @@map("team_folder_members")
}

model Folder {
  id           String   @id @default(uuid()) @db.Char(36)
  orgId        String   @map("org_id") @db.Char(36)
  teamFolderId String?  @map("team_folder_id") @db.Char(36)
  parentId     String?  @map("parent_id") @db.Char(36)
  name         String
  ownerId      String   @map("owner_id") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  teamFolder   TeamFolder?  @relation(fields: [teamFolderId], references: [id])
  parent       Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children     Folder[]     @relation("FolderTree")
  owner        User         @relation("FolderOwner", fields: [ownerId], references: [id])
  files        File[]
  trashEntries TrashEntry[]

  @@index([orgId, parentId])
  @@index([orgId, teamFolderId])
  @@fulltext([name])
  @@map("folders")
}

/// Logical file entity. Physical bytes live in StorageObject, per-version.
model File {
  id             String         @id @default(uuid()) @db.Char(36)
  orgId          String         @map("org_id") @db.Char(36)
  folderId       String?        @map("folder_id") @db.Char(36)
  name           String
  originalName   String         @map("original_name")
  extension      String?
  mimeType       String?        @map("mime_type")
  fileType       FileType       @default(OTHER) @map("file_type")
  size           BigInt         @default(0)
  sha256Hash     String?        @map("sha256_hash") @db.Char(64)
  status         FileStatus     @default(ACTIVE)
  visibility     FileVisibility @default(PRIVATE)
  ownerId        String         @map("owner_id") @db.Char(36)
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")

  organization   Organization    @relation(fields: [orgId], references: [id])
  folder         Folder?         @relation(fields: [folderId], references: [id])
  owner          User            @relation("FileOwner", fields: [ownerId], references: [id])
  versions       FileVersion[]
  comments       Comment[]
  metadata       FileMetadata?
  storageObjects StorageObject[]
  activities     FileActivity[]
  tags           FileTag[]
  trashEntries   TrashEntry[]
  shares         FileShare[]

  @@index([orgId, folderId])
  @@index([orgId, status])
  @@index([orgId, fileType])
  @@index([orgId, ownerId])
  @@fulltext([name])
  @@map("files")
}

/// Technical metadata extracted from file content. One-to-one with File.
model FileMetadata {
  id          String   @id @default(uuid()) @db.Char(36)
  fileId      String   @unique @map("file_id") @db.Char(36)
  width       Int?
  height      Int?
  duration    Int?
  pageCount   Int?     @map("page_count")
  encoding    String?
  language    String?
  title       String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_metadata")
}

/// Physical object stored in object storage (S3/MinIO/local disk).
/// Ownership is soft: several files/versions can reference one physical
/// object (copy/restore), so the owning file link is nullable and set to
/// NULL when the creating file is purged while other references remain.
model StorageObject {
  id         String              @id @default(uuid()) @db.Char(36)
  orgId      String              @map("org_id") @db.Char(36)
  fileId     String?             @map("file_id") @db.Char(36)
  storageKey String              @map("storage_key")
  bucket     String
  region     String?
  size       BigInt              @default(0)
  checksum   String?
  status     StorageObjectStatus @default(ACTIVE)
  createdAt  DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  file         File?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  versions     FileVersion[]

  @@unique([bucket, storageKey])
  @@index([orgId, fileId])
  @@index([orgId, status])
  @@map("storage_objects")
}

/// Immutable version of a file pointing at one physical StorageObject.
model FileVersion {
  id              String        @id @default(uuid()) @db.Char(36)
  orgId           String        @map("org_id") @db.Char(36)
  fileId          String        @map("file_id") @db.Char(36)
  versionNumber   Int           @map("version_number")
  storageObjectId String        @map("storage_object_id") @db.Char(36)
  size            BigInt
  mimeType        String        @map("mime_type")
  extension       String?
  sha256Hash      String        @map("sha256_hash") @db.Char(64)
  uploadedById    String        @map("uploaded_by") @db.Char(36)
  status          VersionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [orgId], references: [id])
  file          File          @relation(fields: [fileId], references: [id])
  uploadedBy    User          @relation("VersionUploader", fields: [uploadedById], references: [id])
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id])

  @@unique([fileId, versionNumber])
  @@index([orgId, sha256Hash])
  @@index([orgId, status])
  @@map("file_versions")
}

/// Authoritative record of every deletion and restoration (recycle bin).
model TrashEntry {
  id           String      @id @default(uuid()) @db.Char(36)
  orgId        String      @map("org_id") @db.Char(36)
  fileId       String?     @map("file_id") @db.Char(36)
  folderId     String?     @map("folder_id") @db.Char(36)
  deletedById  String      @map("deleted_by_id") @db.Char(36)
  reason       TrashReason @default(USER_DELETED)
  deletedAt    DateTime    @default(now()) @map("deleted_at")
  expiresAt    DateTime    @map("expires_at")
  restoredAt   DateTime?   @map("restored_at")
  restoredById String?     @map("restored_by_id") @db.Char(36)

  organization Organization @relation(fields: [orgId], references: [id])
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder       Folder?      @relation(fields: [folderId], references: [id])
  deletedBy    User         @relation("TrashEntryDeletedBy", fields: [deletedById], references: [id])
  restoredBy   User?        @relation("TrashEntryRestoredBy", fields: [restoredById], references: [id])

  @@index([orgId, expiresAt])
  @@index([orgId, deletedAt])
  @@index([fileId])
  @@index([folderId])
  @@map("trash_entries")
}

/// Share of a single file: direct recipients or public link.
model FileShare {
  id           String          @id @default(uuid()) @db.Char(36)
  orgId        String          @map("org_id") @db.Char(36)
  fileId       String          @map("file_id") @db.Char(36)
  createdById  String          @map("created_by_id") @db.Char(36)
  permission   SharePermission @default(VIEW)
  status       ShareStatus     @default(ACTIVE)
  linkToken    String          @unique @map("link_token")
  passwordHash String?         @map("password_hash")
  expiresAt    DateTime?       @map("expires_at")
  canDownload  Boolean         @default(true) @map("can_download")
  createdAt    DateTime        @default(now()) @map("created_at")
  revokedAt    DateTime?       @map("revoked_at")

  organization Organization         @relation(fields: [orgId], references: [id])
  file         File                 @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("FileShareCreator", fields: [createdById], references: [id])
  recipients   FileShareRecipient[]

  @@index([orgId, fileId])
  @@index([orgId, status])
  @@index([orgId, createdById])
  @@map("file_shares")
}

model FileShareRecipient {
  id        String   @id @default(uuid()) @db.Char(36)
  orgId     String   @map("org_id") @db.Char(36)
  shareId   String   @map("share_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  share        FileShare    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([orgId, userId])
  @@map("file_share_recipients")
}

/// User-facing file timeline (activity feed). Not a security audit trail.
model FileActivity {
  id        String      @id @default(uuid()) @db.Char(36)
  orgId     String      @map("org_id") @db.Char(36)
  fileId    String      @map("file_id") @db.Char(36)
  userId    String?     @map("user_id") @db.Char(36)
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([orgId, fileId, createdAt])
  @@index([orgId, userId, createdAt])
  @@index([orgId, action, createdAt])
  @@map("file_activities")
}

model Tag {
  id        String   @id @default(uuid()) @db.Char(36)
  orgId     String   @map("org_id") @db.Char(36)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  files        FileTag[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("tags")
}

model FileTag {
  fileId String @map("file_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([tagId])
  @@map("file_tags")
}

model Favorite {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @map("org_id") @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, resourceType, resourceId])
  @@index([orgId, userId])
  @@map("favorites")
}

model AccessEvent {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @map("org_id") @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.Char(36)
  action       AccessAction
  accessedAt   DateTime     @default(now()) @map("accessed_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, accessedAt])
  @@index([orgId, resourceType, resourceId, accessedAt])
  @@map("access_events")
}

/// Security/system audit trail. Kept separate from the user-facing FileActivity.
model AuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  orgId        String   @map("org_id") @db.Char(36)
  actorId      String?  @map("actor_id") @db.Char(36)
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Char(36)
  ipAddress    String?  @map("ip_address")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, actorId, createdAt])
  @@map("audit_logs")
}

model OrganizationInvitation {
  id          String           @id @default(uuid()) @db.Char(36)
  orgId       String           @map("org_id") @db.Char(36)
  email       String
  role        OrgRole
  tokenHash   String           @unique @map("token_hash") @db.Char(64)
  invitedById String           @map("invited_by_id") @db.Char(36)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  revokedAt   DateTime?        @map("revoked_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([orgId, email, acceptedAt, revokedAt])
  @@index([orgId, status])
  @@map("organization_invitations")
}

model Session {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @map("org_id") @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  tokenHash    String       @map("token_hash") @db.Char(64)
  expiresAt    DateTime     @map("expires_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastSeenAt   DateTime     @default(now()) @map("last_seen_at")
  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Notification {
  id           String               @id @default(uuid()) @db.Char(36)
  orgId        String               @map("org_id") @db.Char(36)
  userId       String               @map("user_id") @db.Char(36)
  type         NotificationType
  title        String
  body         String?
  priority     NotificationPriority @default(NORMAL)
  resourceType ResourceType?        @map("resource_type")
  resourceId   String?              @map("resource_id") @db.Char(36)
  readAt       DateTime?            @map("read_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, readAt, createdAt])
  @@map("notifications")
}

model Comment {
  id        String    @id @default(uuid()) @db.Char(36)
  orgId     String    @map("org_id") @db.Char(36)
  fileId    String    @map("file_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  parentId  String?   @map("parent_id") @db.Char(36)
  body      String    @db.Text
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]    @relation("CommentThread")

  @@index([orgId, fileId, createdAt])
  @@index([userId])
  @@map("comments")
}

model StorageQuota {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @unique @map("org_id") @db.Char(36)
  quotaBytes   BigInt       @map("quota_bytes")
  usedBytes    BigInt       @default(0) @map("used_bytes")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("storage_quotas")
}
