generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// All DateTime columns are stored in UTC.
enum OrgRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  REMOVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  PENDING
  REMOVED
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum FolderAccessLevel {
  NONE
  VIEW
  COMMENT
  EDIT
  ORGANIZE
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TeamFolderRole {
  ADMIN
  ORGANIZER
  EDITOR
  COMMENTER
  VIEWER
}

enum ResourceType {
  FILE
  FOLDER
}

/// Lifecycle state of a logical file.
enum FileStatus {
  ACTIVE
  TRASHED
  ARCHIVED
  PURGED
}

/// Folder type classification
enum FolderType {
  PERSONAL
  TEAM_FOLDER_ROOT
  TEAM_FOLDER_SUB
  SHARED_WITH_ME
  ARCHIVED_MEMBER
}

/// Membership link between a user and an organization (multi-tenant support).
model OrganizationMembership {
  id               String           @id @default(uuid()) @db.Char(36)
  userId           String           @map("user_id") @db.Char(36)
  organizationId   String           @map("organization_id") @db.Char(36)
  role             OrgRole          @default(MEMBER)
  isTemplateAdmin  Boolean          @default(false) @map("is_template_admin")
  status           MembershipStatus @default(ACTIVE)
  joinedAt         DateTime         @default(now()) @map("joined_at")
  invitedById      String?          @map("invited_by_id") @db.Char(36)
  isPrimary        Boolean          @default(false) @map("is_primary")
  personalFolderId String?          @unique @map("personal_folder_id") @db.Char(36)
  suspendedAt      DateTime?        @map("suspended_at")
  suspendedById    String?          @map("suspended_by_id") @db.Char(36)
  removedAt        DateTime?        @map("removed_at")
  removedById      String?          @map("removed_by_id") @db.Char(36)

  user             User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization     @relation("OrganizationMemberships", fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User?            @relation("MembershipInviter", fields: [invitedById], references: [id])
  suspendedBy      User?            @relation("MembershipSuspender", fields: [suspendedById], references: [id])
  removedBy        User?            @relation("MembershipRemover", fields: [removedById], references: [id])
  personalFolder   Folder?          @relation("PersonalFolderOwner", fields: [personalFolderId], references: [id])
  sourceTransfers  DataTransfer[]   @relation("SourceTransfers")
  targetTransfers  DataTransfer[]   @relation("TargetTransfers")

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([userId, isPrimary])
  @@map("organization_memberships")
}

/// Coarse content classification derived from mimeType (never a replacement for it).
enum FileType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  PDF
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  TEXT
  CODE
  OTHER
}

enum FileVisibility {
  PRIVATE
  ORGANIZATION
  TEAM
  SHARED
  PUBLIC_LINK
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
  ORGANIZE
  FULL_ACCESS
}

enum ShareStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  SHARE
  COMMENT
  MENTION
  INVITATION
  FILE_UPLOADED
  FILE_UPDATED
  FILE_DELETED
  FILE_RESTORED
  VERSION_CREATED
  VERSION_RESTORED
  ACCESS_REQUEST
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OfficeEmailProvider {
  SENDGRID
  GMAIL
}

/// Security/system audit actions. Kept separate from the user-facing file timeline.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  MOVE
  COPY
  DOWNLOAD
  PREVIEW
  SHARE
  UNSHARE
  COMMENT
  UPLOAD_VERSION
  RESTORE_VERSION
  LOGIN
  LOGOUT
  INVITE
  ACCEPT_INVITATION
  REVOKE_INVITATION
  CHANGE_PERMISSION
  OWNERSHIP_TRANSFERRED
}

enum TrashReason {
  USER_DELETED
  OWNER_DELETED
  PARENT_DELETED
  ADMIN_DELETED
}

enum UploadStatus {
  PENDING
  COMPLETE
  ABORTED
}

enum UploadSessionStatus {
  PENDING
  COMPLETE
  ABORTED
  EXPIRED
}

enum VersionStatus {
  ACTIVE
  RESTORED
  SUPERSEDED
  DELETED
}

enum AccessAction {
  VIEW
  PREVIEW
  DOWNLOAD
  EDIT
  COMMENT
  SHARE
  MOVE
  COPY
  DELETE
  RESTORE
}

enum StorageObjectStatus {
  ACTIVE
  DELETED
  CORRUPTED
}

model Organization {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  ownerId   String?  @unique @map("owner_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  owner User? @relation("OrganizationOwner", fields: [ownerId], references: [id])
  uploadSessions UploadSession[]
  currentUsers User[] @relation("UserCurrentOrganization")
  officeSecurityPolicies OfficeSecurityPolicy[]

  memberships         OrganizationMembership[] @relation("OrganizationMemberships")
  teamFolders         TeamFolder[]
  teamFolderMembers   TeamFolderMember[]
  folders             Folder[]
  files               File[]
  fileVersions        FileVersion[]
  storageObjects      StorageObject[]
  shares              FileShare[]
  folderShares        FolderShare[]
  folderShareRecipients FolderShareRecipient[]
  shareRecipients     FileShareRecipient[]
  auditLogs           AuditLog[]
  officeAuditPolicy   OfficeAuditPolicy?
  favorites           Favorite[]
  accessEvents        AccessEvent[]
  sessions            Session[]
  notifications       Notification[]
  officeNotificationPreferences OfficeNotificationPreference[]
  officeEmailSettings           OfficeEmailSettings[]
  comments            Comment[]
  quota               StorageQuota?
  invitations         OrganizationInvitation[]
  tags                Tag[]
  trashEntries        TrashEntry[]
  fileActivities      FileActivity[]
  groups              Group[]
  groupMembers        GroupMember[]
  folderPermissions   FolderPermission[]
  securityPolicy      SecurityPolicy?
  dlpLabels           DlpClassificationLabel[]
  dlpPolicies         DlpPolicy[]
  dlpFileLabels       FileDlpLabel[]
  retentionPolicy     RetentionPolicy?
  malwareScans        MalwareScan[]
  securityEvents      SecurityEvent[]
  connections         Connection[]
  externalStorageMounts ExternalStorageMount[]
  connectionCustomServices ConnectionCustomService[]
  connectionProviderConfigs ConnectionProviderConfig[]
  connectionUsages    ConnectionUsage[]
  connectionHealthChecks ConnectionHealthCheck[]
  connectionHealthAlerts ConnectionHealthAlert[]
  devices             UserDevice[]
  dataTransfers       DataTransfer[]
  templateLibraries   TemplateLibrary[]
  officeDocuments OfficeDocument[]
  officeDocumentVersions OfficeDocumentVersion[] @relation("OfficeDocumentVersionOrganization")
  officePresences OfficePresence[]
  officeOperations OfficeOperation[]
  officeSessions OfficeSession[] @relation("OrganizationOfficeSessions")
  officeBackgroundJobs OfficeBackgroundJob[]
  templateCategories  TemplateCategory[]
  templates           Template[]
  dataTemplates       FileDataTemplate[]

  workflows Workflow[]
  workflowRuns WorkflowRun[] @relation("OrganizationWorkflowRuns")
  workflowJobs WorkflowJob[]
  workflowTasks WorkflowTask[]
  workflowDataTemplates WorkflowDataTemplate[]
  workflowFunctions WorkflowFunction[]
  workflowFunctionVersions WorkflowFunctionVersion[] @relation("WorkflowFunctionVersionOrganization")
  workflowFunctionExecutions WorkflowFunctionExecution[]
  workflowDataTemplateVersions WorkflowDataTemplateVersion[]

  @@map("organizations")
}

model User {
  id                   String     @id @default(uuid()) @db.Char(36)
  email                String
  name                 String?
  passwordHash         String?    @map("password_hash")
  googleId             String?    @unique @map("google_id")
  status               UserStatus @default(ACTIVE)
  avatarUrl            String?    @map("avatar_url")
  lastLoginAt          DateTime?  @map("last_login_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  currentOrganizationId String?   @map("current_organization_id") @db.Char(36)
  themeMode            String     @default("light") @map("theme_mode")
  themeColor           String     @default("blue") @map("theme_color")
  fontFamily           String     @default("Zoho Puvi") @map("font_family")
  lighterSidebar       Boolean    @default(false) @map("lighter_sidebar")

  currentOrganization Organization? @relation("UserCurrentOrganization", fields: [currentOrganizationId], references: [id], onDelete: SetNull)

  memberships          OrganizationMembership[] @relation("UserMemberships")
  uploadSessions       UploadSession[]
  ownedOrganizations     Organization[]         @relation("OrganizationOwner")
  teamFolderMembers      TeamFolderMember[]
  ownedFolders           Folder[]               @relation("FolderOwner")
  ownedFiles             File[]                 @relation("FileOwner")
  uploadedVersions       FileVersion[]          @relation("VersionUploader")
  auditLogs              AuditLog[]
  officeAuditPoliciesUpdated OfficeAuditPolicy[] @relation("OfficeAuditPolicyUpdater")
  favorites              Favorite[]
  accessEvents           AccessEvent[]
  shareRecipients        FileShareRecipient[]
  folderShareRecipients   FolderShareRecipient[]
  folderSharesCreated     FolderShare[] @relation("FolderShareCreator")
  sharesCreated          FileShare[]            @relation("FileShareCreator")
  sessions               Session[]
  notifications          Notification[]
  officeNotificationPreferences OfficeNotificationPreference[]
  officeEmailSettingsUpdated   OfficeEmailSettings[] @relation("OfficeEmailSettingsUpdater")
  comments               Comment[]
  resetTokens            PasswordResetToken[]
  invitationsSent        OrganizationInvitation[] @relation("InvitationSender")
  trashDeletedBy         TrashEntry[]           @relation("TrashEntryDeletedBy")
  trashRestoredBy        TrashEntry[]           @relation("TrashEntryRestoredBy")
  fileActivities         FileActivity[]
  groupsCreated          Group[]
  groupMemberships       GroupMember[]
  folderPermissions      FolderPermission[]
  devices                UserDevice[]
  securityEvents         SecurityEvent[]
  membershipsInvited     OrganizationMembership[] @relation("MembershipInviter")
  membershipsSuspended   OrganizationMembership[] @relation("MembershipSuspender")
  membershipsRemoved     OrganizationMembership[] @relation("MembershipRemover")
  dataTransfersInitiated DataTransfer[]         @relation("DataTransferInitiator")
  connections            Connection[] @relation("ConnectionOwner")
  externalStorageMounts   ExternalStorageMount[] @relation("ExternalStorageMountUser")
  connectionCustomServices ConnectionCustomService[] @relation("ConnectionCustomServiceOwner")
  connectionProviderConfigsCreated ConnectionProviderConfig[] @relation("ConnectionProviderConfigCreatedBy")
  connectionProviderConfigsUpdated ConnectionProviderConfig[] @relation("ConnectionProviderConfigUpdatedBy")
  connectionSecrets      ConnectionSecret[]
  connectionSecretVersions ConnectionSecretVersion[] @relation("ConnectionSecretVersionCreator")
  connectionUsages       ConnectionUsage[]
  templateLibrariesOwned TemplateLibrary[] @relation("TemplateLibraryOwner")
  templatesOwned         Template[] @relation("TemplateOwner")
  templateVersionsCreated TemplateVersion[] @relation("TemplateVersionCreator")
  templateBuildersPublished TemplateBuilder[] @relation("TemplateBuilderPublisher")
  templateAutomationRuns TemplateAutomationRun[] @relation("TemplateAutomationRunCreator")
  officeSessions OfficeSession[]
  officePresences OfficePresence[]
  officeOperations OfficeOperation[]
  officeDocumentPolicyUpdates OfficeDocumentPolicy[] @relation("OfficeDocumentPolicyUpdater")
  officeSecurityPolicyUpdates OfficeSecurityPolicy[] @relation("OfficeSecurityPolicyUpdater")
  officeBackgroundJobs OfficeBackgroundJob[]
  officeDocumentVersionsCreated OfficeDocumentVersion[] @relation("OfficeDocumentVersionCreator")


  @@unique([email])
  @@index([email])
  @@index([currentOrganizationId])
  workflows Workflow[]
  workflowRuns WorkflowRun[]
  workflowTasks WorkflowTask[]
  workflowTaskParticipants WorkflowTaskParticipant[]
  workflowDataTemplates WorkflowDataTemplate[]
  workflowFunctions WorkflowFunction[]
  workflowFunctionVersions WorkflowFunctionVersion[] @relation("WorkflowFunctionVersionCreator")
  workflowDataTemplateVersions WorkflowDataTemplateVersion[]

  connectionShares       ConnectionShare[] @relation("ConnectionShareUser")

  @@map("users")

}

model TeamFolder {
  id                   String    @id @default(uuid()) @db.Char(36)
  orgId                String    @map("org_id") @db.Char(36)
  name                 String
  isPublicToOrg        Boolean   @default(false) @map("is_public_to_org")
  allowExternalSharing Boolean   @default(true) @map("allow_external_sharing")
  allowViewerDownloads Boolean   @default(true) @map("allow_viewer_downloads")
  archivedAt           DateTime? @map("archived_at")

  organization Organization       @relation(fields: [orgId], references: [id])
  members      TeamFolderMember[]
  folders      Folder[]

  @@index([orgId])
  @@map("team_folders")
}

model TeamFolderMember {
  teamFolderId String         @map("team_folder_id") @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  orgId        String         @map("org_id") @db.Char(36)
  role         TeamFolderRole

  teamFolder   TeamFolder   @relation(fields: [teamFolderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([teamFolderId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("team_folder_members")
}

model Folder {
  id           String      @id @default(uuid()) @db.Char(36)
  orgId        String      @map("org_id") @db.Char(36)
  teamFolderId String?     @map("team_folder_id") @db.Char(36)
  parentId     String?     @map("parent_id") @db.Char(36)
  name         String
  ownerId      String      @map("owner_id") @db.Char(36)
  folderType   FolderType  @default(PERSONAL) @map("folder_type")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id])
  teamFolder   TeamFolder?        @relation(fields: [teamFolderId], references: [id])
  parent       Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]           @relation("FolderTree")
  owner        User               @relation("FolderOwner", fields: [ownerId], references: [id])
  personalFolderOf OrganizationMembership? @relation("PersonalFolderOwner")
  files        File[]
  trashEntries TrashEntry[]
  dataTemplateId String? @map("data_template_id") @db.Char(36)
  dataTemplate FileDataTemplate? @relation(fields: [dataTemplateId], references: [id], onDelete: SetNull)
  permissions  FolderPermission[]
  shares       FolderShare[]

  @@index([orgId, parentId])
  @@index([orgId, teamFolderId])
  @@index([orgId, folderType])
  @@index([ownerId])
  @@fulltext([name])
  @@map("folders")
}

/// Logical file entity. Physical bytes live in StorageObject, per-version.
model File {
  id             String         @id @default(uuid()) @db.Char(36)
  orgId          String         @map("org_id") @db.Char(36)
  folderId       String?        @map("folder_id") @db.Char(36)
  name           String
  originalName   String         @map("original_name")
  extension      String?
  mimeType       String?        @map("mime_type")
  fileType       FileType       @default(OTHER) @map("file_type")
  size           BigInt         @default(0)
  sha256Hash     String?        @map("sha256_hash") @db.Char(64)
  status         FileStatus     @default(ACTIVE)
  visibility     FileVisibility @default(PRIVATE)
  ownerId        String         @map("owner_id") @db.Char(36)
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")
  storageKey      String?      @map("storage_key")
  storageObjectId String?      @map("storage_object_id") @db.Char(36)

  organization   Organization    @relation(fields: [orgId], references: [id])
  folder         Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner          User            @relation("FileOwner", fields: [ownerId], references: [id])
  versions       FileVersion[]
  uploadSessions UploadSession[]
  comments       Comment[]
  metadata       FileMetadata?
  storageObjects StorageObject[]
  activities     FileActivity[]
  tags           FileTag[]
  dlpLabels      FileDlpLabel[]
  trashEntries   TrashEntry[]
  shares         FileShare[]
  malwareScans   MalwareScan[]
  officeDocument OfficeDocument?
  officeDocumentVersions OfficeDocumentVersion[] @relation("OfficeDocumentVersionFile")
  officeSessions OfficeSession[]
  officePresences OfficePresence[]
  officeOperations OfficeOperation[]

  @@index([orgId, folderId])
  @@index([orgId, status])
  @@index([orgId, fileType])
  @@index([orgId, ownerId])
  @@index([ownerId])
  @@fulltext([name])
  @@map("files")
}


enum OfficeDocumentType {
  WRITER
  SHEET
  SHOW
}


model OfficeSecurityPolicy {
  id                String   @id @default(uuid()) @db.Char(36)
  orgId             String   @unique @map("org_id") @db.Char(36)
  forceReadOnly     Boolean  @default(false) @map("force_read_only")
  disableExport     Boolean  @default(false) @map("disable_export")
  disableCopy       Boolean  @default(false) @map("disable_copy")
  disableOffline    Boolean  @default(false) @map("disable_offline")
  requireWatermark  Boolean  @default(false) @map("require_watermark")
  watermarkText     String?  @map("watermark_text") @db.VarChar(500)
  updatedById       String?  @map("updated_by_id") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy         User? @relation("OfficeSecurityPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("office_security_policies")
}

model OfficeDocumentPolicy {
  id              String   @id @default(uuid()) @db.Char(36)
  documentId      String   @unique @map("document_id") @db.Char(36)
  allowExport     Boolean  @default(true) @map("allow_export")
  allowCopy       Boolean  @default(true) @map("allow_copy")
  allowOffline    Boolean  @default(true) @map("allow_offline")
  readOnly        Boolean  @default(false)
  watermarkEnabled Boolean @default(false) @map("watermark_enabled")
  watermarkText   String?  @map("watermark_text") @db.VarChar(500)
  updatedById     String?  @map("updated_by_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  document        OfficeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  updatedBy       User? @relation("OfficeDocumentPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("office_document_policies")
}

model OfficeDocumentVersion {
  id           String   @id @default(uuid()) @db.Char(36)
  orgId        String   @map("org_id") @db.Char(36)
  documentId   String   @map("document_id") @db.Char(36)
  fileId       String   @map("file_id") @db.Char(36)
  versionNumber Int     @map("version_number")
  revision     Int
  type         OfficeDocumentType
  content      Json
  contentHash  String   @map("content_hash") @db.Char(64)
  label        String?  @db.VarChar(255)
  createdById  String   @map("created_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization  @relation("OfficeDocumentVersionOrganization", fields: [orgId], references: [id], onDelete: Cascade)
  document     OfficeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  file         File           @relation("OfficeDocumentVersionFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("OfficeDocumentVersionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([orgId, fileId, createdAt])
  @@index([documentId, revision])
  @@index([createdById, createdAt])
  @@map("office_document_versions")
}

enum OfficeSessionStatus {
  ACTIVE
  CLOSED
}

model OfficeDocument {
  id           String             @id @default(uuid()) @db.Char(36)
  orgId        String             @map("org_id") @db.Char(36)
  fileId       String             @unique @map("file_id") @db.Char(36)
  type         OfficeDocumentType
  nativeFormat String             @map("native_format")
  content      Json
  revision     Int                @default(1)
  sourceTemplateId        String? @map("source_template_id") @db.Char(36)
  sourceTemplateVersionId String? @map("source_template_version_id") @db.Char(36)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sessions     OfficeSession[]
  operations   OfficeOperation[]
  versions     OfficeDocumentVersion[]
  policy       OfficeDocumentPolicy?

  @@index([orgId, type])
  @@index([orgId, updatedAt])
  @@index([orgId, sourceTemplateId])
  @@index([sourceTemplateId, sourceTemplateVersionId])
  @@map("office_documents")
}

model OfficeSession {
  id             String              @id @default(uuid()) @db.Char(36)
  orgId          String              @map("org_id") @db.Char(36)
  fileId         String              @map("file_id") @db.Char(36)
  documentId     String              @map("document_id") @db.Char(36)
  userId         String              @map("user_id") @db.Char(36)
  type           OfficeDocumentType
  status         OfficeSessionStatus @default(ACTIVE)
  openedAt       DateTime            @default(now()) @map("opened_at")
  lastActivityAt DateTime            @updatedAt @map("last_activity_at")
  closedAt       DateTime?           @map("closed_at")

  organization Organization  @relation("OrganizationOfficeSessions", fields: [orgId], references: [id], onDelete: Cascade)
  file         File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  document     OfficeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  presence     OfficePresence?
  operations   OfficeOperation[]

  @@index([orgId, fileId, status])
  @@index([orgId, userId, status])
  @@index([documentId, status])
  @@map("office_sessions")
}

enum OfficePresenceStatus {
  ACTIVE
  IDLE
}

model OfficePresence {
  id         String @id @default(uuid()) @db.Char(36)
  orgId      String @map("org_id") @db.Char(36)
  fileId     String @map("file_id") @db.Char(36)
  sessionId  String @unique @map("session_id") @db.Char(36)
  userId     String @map("user_id") @db.Char(36)
  cursor     Json?
  selection  Json?
  status     OfficePresenceStatus @default(ACTIVE)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file         File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  session      OfficeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, fileId, status])
  @@index([userId, status])
  @@map("office_presence")
}

model OfficeOperation {
  id           String @id @default(uuid()) @db.Char(36)
  orgId        String @map("org_id") @db.Char(36)
  fileId       String @map("file_id") @db.Char(36)
  documentId   String @map("document_id") @db.Char(36)
  sessionId    String? @map("session_id") @db.Char(36)
  userId       String @map("user_id") @db.Char(36)
  kind         String @db.VarChar(64)
  baseRevision Int @map("base_revision")
  revision     Int
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file         File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  document     OfficeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  session      OfficeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, fileId, revision])
  @@index([documentId, revision])
  @@index([userId, createdAt])
  @@map("office_operations")
}

enum TemplateLibraryType {
  PERSONAL
  ORGANIZATION
  PUBLIC
}

enum TemplateVariableType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  EMAIL
  URL
  CURRENCY
  IMAGE
  USER
  FILE
  CHOICE
}

enum TemplateType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
}

enum TemplateStatus {
  ACTIVE
  DISABLED
  TRASHED
}

model TemplateLibrary {
  id             String              @id @default(uuid()) @db.Char(36)
  orgId          String?             @map("org_id") @db.Char(36)
  ownerId        String?             @map("owner_id") @db.Char(36)
  type           TemplateLibraryType
  name           String
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?         @relation("TemplateLibraryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  categories   TemplateCategory[]
  templates    Template[]

  @@unique([orgId, ownerId, type])
  @@index([orgId, type])
  @@map("template_libraries")
}

model TemplateCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  orgId       String?  @map("org_id") @db.Char(36)
  libraryId   String   @map("library_id") @db.Char(36)
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  library      TemplateLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  templates    Template[]

  @@unique([libraryId, name])
  @@index([orgId, libraryId])
  @@map("template_categories")
}

model Template {
  id             String         @id @default(uuid()) @db.Char(36)
  orgId          String?        @map("org_id") @db.Char(36)
  libraryId      String         @map("library_id") @db.Char(36)
  categoryId     String?        @map("category_id") @db.Char(36)
  ownerId        String?        @map("owner_id") @db.Char(36)
  name           String
  description    String?        @db.Text
  type           TemplateType
  status         TemplateStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  library      TemplateLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  category     TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner        User? @relation("TemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]
  variables    TemplateVariable[]
  builder      TemplateBuilder?
  automationRuns TemplateAutomationRun[]

  @@index([orgId, libraryId, status])
  @@index([orgId, ownerId])
  @@index([libraryId, categoryId])
  @@fulltext([name, description])
  @@map("templates")
}



model TemplateBuilder {
  id             String    @id @default(uuid()) @db.Char(36)
  templateId     String    @unique @map("template_id") @db.Char(36)
  draft          Json
  published      Json?
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  template       Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedBy    User?     @relation("TemplateBuilderPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([publishedById])
  @@map("template_builders")
}

model TemplateVariable {
  id          String                 @id @default(uuid()) @db.Char(36)
  templateId  String                 @map("template_id") @db.Char(36)
  name        String
  label       String
  type        TemplateVariableType
  defaultValue String?               @map("default_value") @db.Text
  required    Boolean                @default(false)
  description String?                @db.Text
  options     Json?
  format      String?
  position    Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@index([templateId, position])
  @@map("template_variables")
}


enum TemplateAutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum OfficeBackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model OfficeBackgroundJob {
  id          String                  @id @default(uuid()) @db.Char(36)
  orgId       String                  @map("org_id") @db.Char(36)
  createdById String                  @map("created_by_id") @db.Char(36)
  type        String                  @db.VarChar(64)
  status      OfficeBackgroundJobStatus @default(QUEUED)
  payload     Json
  result      Json?
  error       String?                 @db.Text
  attempts    Int                     @default(0)
  maxAttempts Int                     @default(3) @map("max_attempts")
  runAt       DateTime                @default(now()) @map("run_at")
  lockedAt    DateTime?               @map("locked_at")
  lockedBy    String?                 @map("locked_by")
  leaseUntil  DateTime?               @map("lease_until")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([orgId, status, runAt])
  @@index([status, runAt, createdAt])
  @@index([createdById, createdAt])
  @@map("office_background_jobs")
}

model TemplateAutomationRun {
  id                String                    @id @default(uuid()) @db.Char(36)
  templateId        String                    @map("template_id") @db.Char(36)
  templateVersionId String?                   @map("template_version_id") @db.Char(36)
  createdById       String                    @map("created_by_id") @db.Char(36)
  status            TemplateAutomationRunStatus @default(PENDING)
  name              String
  values            Json
  fileId            String?                   @map("file_id") @db.Char(36)
  pdfFileId         String?                   @map("pdf_file_id") @db.Char(36)
  error             String?                   @db.Text
  startedAt         DateTime?                 @map("started_at")
  completedAt       DateTime?                 @map("completed_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  template        Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("TemplateAutomationRunCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@map("template_automation_runs")
}

model TemplateVersion {
  id            String   @id @default(uuid()) @db.Char(36)
  templateId    String   @map("template_id") @db.Char(36)
  versionNumber Int      @map("version_number")
  storageKey    String   @map("storage_key")
  size          BigInt
  mimeType      String   @map("mime_type")
  extension     String?
  sha256Hash    String   @map("sha256_hash") @db.Char(64)
  createdById   String   @map("created_by_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")

  template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User     @relation("TemplateVersionCreator", fields: [createdById], references: [id])
  automationRuns TemplateAutomationRun[]

  @@unique([templateId, versionNumber])
  @@index([templateId, createdAt])
  @@map("template_versions")
}

/// Technical metadata extracted from file content. One-to-one with File.
model FileMetadata {
  id          String   @id @default(uuid()) @db.Char(36)
  fileId      String   @unique @map("file_id") @db.Char(36)
  width       Int?
  height      Int?
  duration    Int?
  pageCount   Int?     @map("page_count")
  encoding    String?
  language    String?
  title       String?
  description String?  @db.Text
  customFields Json? @map("custom_fields")
  contentText String? @map("content_text") @db.LongText
  ocrText     String? @map("ocr_text") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  dataTemplate FileDataTemplate? @relation(fields: [dataTemplateId], references: [id], onDelete: SetNull)
  dataTemplateId String? @map("data_template_id") @db.Char(36)

  @@index([dataTemplateId])
  @@map("file_metadata")
}


/// Organization-scoped data template for file metadata/custom fields.
model FileDataTemplate {
  id            String   @id @default(uuid()) @db.Char(36)
  orgId         String   @map("org_id") @db.Char(36)
  name          String
  description   String?  @db.Text
  schema        Json
  requiredFields Json? @map("required_fields")
  active        Boolean  @default(true)
  createdById   String   @map("created_by_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folders       Folder[]
  metadata      FileMetadata[]
  @@unique([orgId, name])
  @@index([orgId, active])
  @@map("file_data_templates")
}

/// Physical object stored in object storage (S3/MinIO/local disk).
model StorageObject {
  id         String              @id @default(uuid()) @db.Char(36)
  orgId      String              @map("org_id") @db.Char(36)
  fileId     String?             @map("file_id") @db.Char(36)
  storageKey String              @map("storage_key")
  bucket     String
  region     String?
  size       BigInt              @default(0)
  checksum   String?
  status     StorageObjectStatus @default(ACTIVE)
  createdAt  DateTime            @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  file         File?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  versions     FileVersion[]

  @@unique([bucket, storageKey])
  @@index([orgId, fileId])
  @@index([orgId, status])
  @@map("storage_objects")
}

/// Immutable version of a file pointing at one physical StorageObject.
model FileVersion {
  id              String        @id @default(uuid()) @db.Char(36)
  orgId           String        @map("org_id") @db.Char(36)
  fileId          String        @map("file_id") @db.Char(36)
  versionNumber   Int           @map("version_number")
  storageObjectId String        @map("storage_object_id") @db.Char(36)
  size            BigInt
  mimeType        String        @map("mime_type")
  extension       String?
  sha256Hash      String        @map("sha256_hash") @db.Char(64)
  uploadedById    String        @map("uploaded_by") @db.Char(36)
  status          VersionStatus @default(ACTIVE)
  uploadStatus    UploadStatus  @default(COMPLETE) @map("upload_status")
  createdAt       DateTime      @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [orgId], references: [id])
  file          File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("VersionUploader", fields: [uploadedById], references: [id])
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id])
  uploadSession UploadSession?

  @@unique([fileId, versionNumber])
  @@index([orgId, sha256Hash])
  @@index([orgId, status])
  @@index([fileId, uploadStatus])
  @@map("file_versions")
}

/// Authoritative record of every deletion and restoration (recycle bin).
model UploadSession {
  id            String              @id @default(uuid()) @db.Char(36)
  orgId         String              @map("org_id") @db.Char(36)
  fileId        String              @map("file_id") @db.Char(36)
  versionId     String              @unique @map("version_id") @db.Char(36)
  storageUploadId String            @map("storage_upload_id")
  objectKey     String              @map("object_key")
  expectedSize  BigInt              @map("expected_size")
  expectedSha256 String             @map("expected_sha256") @db.Char(64)
  partSize      Int                 @map("part_size")
  totalParts    Int                 @map("total_parts")
  status        UploadSessionStatus @default(PENDING)
  expiresAt     DateTime            @map("expires_at")
  createdById   String              @map("created_by") @db.Char(36)
  createdAt     DateTime            @default(now()) @map("created_at")
  completedAt   DateTime?            @map("completed_at")
  storageCompletedAt DateTime?       @map("storage_completed_at")

  organization Organization @relation(fields: [orgId], references: [id])
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version      FileVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  parts        UploadPart[]

  @@index([orgId, status, expiresAt])
  @@index([fileId, status])
  @@map("upload_sessions")
}

model UploadPart {
  id          String   @id @default(uuid()) @db.Char(36)
  sessionId   String   @map("session_id") @db.Char(36)
  partNumber  Int      @map("part_number")
  size        Int
  checksum    String   @db.Char(64)
  etag        String?
  createdAt   DateTime @default(now()) @map("created_at")

  session UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, partNumber])
  @@index([sessionId, partNumber])
  @@map("upload_parts")
}

model TrashEntry {
  id           String      @id @default(uuid()) @db.Char(36)
  orgId        String      @map("org_id") @db.Char(36)
  fileId       String?     @map("file_id") @db.Char(36)
  folderId     String?     @map("folder_id") @db.Char(36)
  deletedById  String      @map("deleted_by_id") @db.Char(36)
  reason       TrashReason @default(USER_DELETED)
  deletedAt    DateTime    @default(now()) @map("deleted_at")
  expiresAt    DateTime    @map("expires_at")
  restoredAt   DateTime?   @map("restored_at")
  restoredById String?     @map("restored_by_id") @db.Char(36)

  organization Organization @relation(fields: [orgId], references: [id])
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  deletedBy    User         @relation("TrashEntryDeletedBy", fields: [deletedById], references: [id])
  restoredBy   User?        @relation("TrashEntryRestoredBy", fields: [restoredById], references: [id])

  @@index([orgId, expiresAt])
  @@index([orgId, deletedAt])
  @@index([fileId])
  @@index([folderId])
  @@map("trash_entries")
}

/// Tracks data ownership transfer when a member is removed or suspended
model DataTransfer {
  id              String         @id @default(uuid()) @db.Char(36)
  orgId           String         @map("org_id") @db.Char(36)
  sourceMemberId  String         @map("source_member_id") @db.Char(36)
  targetMemberId  String         @map("target_member_id") @db.Char(36)
  initiatedById   String         @map("initiated_by_id") @db.Char(36)
  status          DataTransferStatus @default(PENDING)
  transferType    DataTransferType   @default(FULL_OWNERSHIP)
  itemsTotal      Int            @default(0) @map("items_total")
  itemsTransferred Int           @default(0) @map("items_transferred")
  itemsFailed     Int            @default(0) @map("items_failed")
  errorLog        Json?
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  organization    Organization   @relation(fields: [orgId], references: [id])
  sourceMember    OrganizationMembership @relation("SourceTransfers", fields: [sourceMemberId], references: [id])
  targetMember    OrganizationMembership @relation("TargetTransfers", fields: [targetMemberId], references: [id])
  initiatedBy     User           @relation("DataTransferInitiator", fields: [initiatedById], references: [id])

  @@index([orgId, status])
  @@index([orgId, sourceMemberId])
  @@index([orgId, targetMemberId])
  @@map("data_transfers")
}

enum DataTransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum DataTransferType {
  FULL_OWNERSHIP
  SELECTIVE_FILES
  SELECTIVE_FOLDERS
}

/// Share of a single file: direct recipients or public link.
model FileShare {
  id           String          @id @default(uuid()) @db.Char(36)
  orgId        String          @map("org_id") @db.Char(36)
  fileId       String          @map("file_id") @db.Char(36)
  createdById  String          @map("created_by_id") @db.Char(36)
  permission   SharePermission @default(VIEW)
  status       ShareStatus     @default(ACTIVE)
  linkToken    String          @unique @map("link_token")
  passwordHash String?         @map("password_hash")
  expiresAt    DateTime?       @map("expires_at")
  canDownload  Boolean         @default(true) @map("can_download")
  createdAt    DateTime        @default(now()) @map("created_at")
  revokedAt    DateTime?       @map("revoked_at")

  organization Organization         @relation(fields: [orgId], references: [id])
  file         File                 @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("FileShareCreator", fields: [createdById], references: [id])
  recipients   FileShareRecipient[]

  @@index([orgId, fileId])
  @@index([orgId, status])
  @@index([orgId, createdById])
  @@map("file_shares")
}

model FileShareRecipient {
  id        String   @id @default(uuid()) @db.Char(36)
  orgId     String   @map("org_id") @db.Char(36)
  shareId   String   @map("share_id") @db.Char(36)
  userId     String         @map("user_id") @db.Char(36)
  permission SharePermission @default(VIEW)
  createdAt  DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  share        FileShare    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([orgId, userId])
  @@map("file_share_recipients")
}

model FolderShare {
  id           String          @id @default(uuid()) @db.Char(36)
  orgId        String          @map("org_id") @db.Char(36)
  folderId     String          @map("folder_id") @db.Char(36)
  createdById  String          @map("created_by_id") @db.Char(36)
  permission   SharePermission @default(VIEW)
  status       ShareStatus     @default(ACTIVE)
  linkToken    String          @unique @map("link_token")
  passwordHash String?         @map("password_hash")
  expiresAt    DateTime?       @map("expires_at")
  canDownload  Boolean         @default(true) @map("can_download")
  createdAt    DateTime        @default(now()) @map("created_at")
  revokedAt    DateTime?       @map("revoked_at")

  organization Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder       Folder                  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("FolderShareCreator", fields: [createdById], references: [id])
  recipients   FolderShareRecipient[]

  @@index([orgId, folderId])
  @@index([orgId, status])
  @@index([orgId, createdById])
  @@map("folder_shares")
}

model FolderShareRecipient {
  id         String         @id @default(uuid()) @db.Char(36)
  orgId      String         @map("org_id") @db.Char(36)
  shareId    String         @map("share_id") @db.Char(36)
  userId     String         @map("user_id") @db.Char(36)
  permission SharePermission @default(VIEW)
  createdAt  DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  share        FolderShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([orgId, userId])
  @@map("folder_share_recipients")
}

model FileActivity {
  id        String      @id @default(uuid()) @db.Char(36)
  orgId     String      @map("org_id") @db.Char(36)
  fileId    String      @map("file_id") @db.Char(36)
  userId    String?     @map("user_id") @db.Char(36)
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([orgId, fileId, createdAt])
  @@index([orgId, userId, createdAt])
  @@index([orgId, action, createdAt])
  @@map("file_activities")
}

model Tag {
  id        String   @id @default(uuid()) @db.Char(36)
  orgId     String   @map("org_id") @db.Char(36)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  files        FileTag[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("tags")
}

model FileTag {
  fileId String @map("file_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([tagId])
  @@map("file_tags")
}

model Favorite {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @map("org_id") @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, resourceType, resourceId])
  @@index([orgId, userId])
  @@map("favorites")
}

model AccessEvent {
  id           String       @id @default(uuid()) @db.Char(36)
  orgId        String       @map("org_id") @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.Char(36)
  action       AccessAction
  accessedAt   DateTime     @default(now()) @map("accessed_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, accessedAt])
  @@index([orgId, resourceType, resourceId, accessedAt])
  @@map("access_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  orgId        String   @map("org_id") @db.Char(36)
  actorId      String?  @map("actor_id") @db.Char(36)
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Char(36)
  ipAddress    String?  @map("ip_address")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  previousHash String?  @map("previous_hash") @db.Char(64)
  integrityHash String? @map("integrity_hash") @db.Char(64)

  organization Organization @relation(fields: [orgId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, resourceType, resourceId, createdAt])
  @@index([orgId, actorId, createdAt])
  @@map("audit_logs")
}

model OfficeAuditPolicy {
  id              String       @id @default(uuid()) @db.Char(36)
  orgId           String       @unique @map("org_id") @db.Char(36)
  retentionDays   Int          @default(365) @map("retention_days")
  immutableChain  Boolean      @default(true) @map("immutable_chain")
  exportEnabled   Boolean      @default(true) @map("export_enabled")
  updatedById     String?      @map("updated_by_id") @db.Char(36)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("OfficeAuditPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([orgId, updatedAt])
  @@map("office_audit_policies")
}

model OrganizationInvitation {
  id          String           @id @default(uuid()) @db.Char(36)
